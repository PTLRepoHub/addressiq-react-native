# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Bumped from min_ios_version_supported (13.4) to 15.1 — react-native-maps@1.26
# (the Collect UI map flow's optional peer dep) requires iOS 15.1.
platform :ios, '16.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AddressIQCore' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'AddressIQCoreTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Pin every pod to the same deployment target as the app.
    #
    # 16.0, not the SDK's own floor. `swiftCompatibility56` back-deploys Swift
    # 5.6 to systems older than iOS 15.4, and current Xcode no longer ships
    # those shims — so anything built below 15.4 fails to link with "Undefined
    # symbols for architecture arm64". 15.1 was not enough; it is under the
    # boundary. This governs only the DEMO APP: the SDK keeps its iOS 13 floor,
    # declared in AddressIQLocation.podspec, and integrators are unaffected.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      end
    end
  end
end
